{{- if .Items }}
{
  "extraKnownMarketplaces": {
    {{ json .Placement.Vars.name }}: {"source": {"source": "directory", "path": {{ json .Placement.Root }}}}
  },
  "enabledPlugins": {
    {{- $first := true }}
    {{- range .Items }}{{ if .Managed }}{{ if not $first }},{{ end }}{{ $first = false }}
    {{ json (printf "%s@%s" .Name $.Placement.Vars.name) }}: true
    {{- end }}{{ end }}
  }
}
{{- end }}
